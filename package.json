{
  "name": "viezan",
  "version": "2.4.2",
  "author": {
    "name": "Viezan",
    "email": "support@viezan.app",
    "url": "https://github.com/trunghieupham59/viezan"
  },
  "license": "MIT",
  "private": true,
  "description": "Viezan native desktop: SwiftUI/Swift on macOS and Qt Quick/C++ on Windows/Linux",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "python3 scripts/native/build.py --output .native-build/dev --launch",
    "build": "python3 scripts/native/build.py --configuration Release --output .native-build/release",
    "build:mac": "python3 scripts/native/build.py --target macos --configuration Release --output .native-build/macos",
    "build:win": "python3 scripts/native/build.py --target qt --configuration Release --output .native-build/windows",
    "build:linux": "python3 scripts/native/build.py --target qt --configuration Release --output .native-build/linux",
    "resources": "node scripts/native/generate-resources.mjs",
    "package:native": "python3 scripts/native/package.py",
    "check:atomic": "node scripts/check-atomic-design.mjs",
    "check:design": "node scripts/check-design-system.mjs",
    "check:agent": "node scripts/validate-viezanagent.mjs",
    "check:docs": "node scripts/native/documentation.mjs",
    "docs:sync": "node scripts/native/documentation.mjs",
    "migrate:legacy": "node scripts/native/convert-legacy.mjs"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "esbuild": "^0.28.2"
  }
}
