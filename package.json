{
  "name": "viezan",
  "version": "2.4.1",
  "description": "Viezan - Local AI Translation - macOS & Windows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,yellow\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:web": "vite --mode web-preview",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && node scripts/run-electron-dev.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:electron": "npm run build:native && tsc -p tsconfig.electron.json && npm run bundle:preloads",
    "bundle:preloads": "esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js && esbuild electron/subtitle-preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/subtitle-preload.js && esbuild electron/update-notification-preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/update-notification-preload.js",
    "build": "npm run build:electron && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "release:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish always",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "postinstall": "electron-builder install-app-deps || true",
    "preview": "vite preview",
    "check:agent": "node scripts/validate-viezanagent.mjs",
    "check:atomic": "node scripts/check-atomic-design.mjs",
    "check:design": "node scripts/check-design-system.mjs",
    "check:biome": "biome check .",
    "check:duplicates": "jscpd --min-lines 8 --min-tokens 80 --threshold 0 --reporters console src electron chrome-extension --ignore \"**/__tests__/**,**/*.test.ts,**/*.test.tsx,src/i18n/locales/**,src/components/ui/icons/**,**/node_modules/**,**/dist/**,**/build/**\"",
    "lint:docs": "markdownlint-cli2 \"viezanagent/**/*.md\" \"README.md\" \"chrome-extension/README.md\"",
    "maintenance:verify": "npm run check:atomic && npm run check:design && npm run build && npm test -- --run && npm run check:biome && npm run check:duplicates && npm run lint:docs && npm run check:agent",
    "test": "vitest",
    "test:web": "node scripts/test-web-preview.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "generate-icons": "node scripts/add-logo-background.mjs",
    "eval:translation-styles": "node scripts/eval-translation-styles.mjs"
  },
  "keywords": [
    "translation",
    "ai",
    "electron",
    "gemini",
    "claude",
    "gpt",
    "Viezan"
  ],
  "author": {
    "name": "Viezan",
    "email": "support@viezan.app",
    "url": "https://github.com/trunghieupham59/viezan"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@google/generative-ai": "^0.24.1",
    "@ricky0123/vad-web": "^0.0.31",
    "electron-updater": "^6.8.9",
    "openai": "^7.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@electron/notarize": "^3.1.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.Viezan.app",
    "productName": "Viezan",
    "copyright": "Copyright © 2024-2025 Viezan. All rights reserved.",
    "artifactName": "Viezan-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "asarUnpack": [
      "**/*.wasm",
      "**/*.onnx"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "extraResources": [{ "from": "native/bin/darwin", "to": "native", "filter": ["viezan-smc", "viezan-fan-helper"] }],
      "binaries": ["Contents/Resources/native/viezan-smc", "Contents/Resources/native/viezan-fan-helper"],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Viezan sends keyboard shortcuts to the active app so Quick Translate can copy the selected text and replace it with the translation."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "afterSign": "scripts/notarize.mjs",
    "beforePack": "scripts/verify-ollama-package.mjs",
    "win": {
      "extraResources": [{ "from": "resources/local-ai/ollama-patched/windows/x64", "to": "local-ai/ollama-patched/windows/x64" }],
      "icon": "build/icon.ico",
      "legalTrademarks": "Viezan",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viezan",
      "menuCategory": "Viezan",
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
