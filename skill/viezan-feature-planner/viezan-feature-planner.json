{
  "name": "viezan-feature-planner",
  "version": "1.0.0",
  "description": "Skill phân rã PRD/issue/feature request của Viezan thành impact map, contracts, implementation plan, verification và risks",
  "type": "skill",
  "classification": {
    "lifecycle": "feature",
    "domain": ["feature-planning", "product-engineering"],
    "use_for": "Turn a PRD, issue, or feature request into an impact map, contracts, plan, verification, and risks."
  },
  "trigger": "Khi cần lập kế hoạch implement một tính năng hoặc PRD cho Viezan",
  "required_context": [
    "../../product-intro.md",
    "../../ARCHITECTURE.md"
  ],
  "optional_context_by_domain": {
    "live_translation": ["../../docs/live_trans.md"],
    "tts": ["../../docs/tts.md", "../../docs/TTS_ARCHITECTURE.md"],
    "general_code_rules": ["../../rule/viezan-product-engineering/rules.json"],
    "browser_extension": ["../../rule/viezan-product-engineering/rules.json", "../../../chrome-extension/README.md"]
  },
  "feature_domains": [
    {
      "id": "text-translate",
      "signals": ["translate text", "rewrite", "detect language", "style", "furigana"],
      "likely_files": [
        "src/pages/TranslatePage.tsx",
        "src/hooks/useTranslate.ts",
        "src/services/translationService.ts",
        "electron/ipc/translate.ts",
        "electron/preload/translate.ts",
        "src/store/slices/coreSlice.ts"
      ]
    },
    {
      "id": "live-translate",
      "signals": ["live", "microphone", "system audio", "subtitle", "transcribe", "session summary"],
      "likely_files": [
        "src/pages/LiveTranslatePage.tsx",
        "src/hooks/useLiveTranslate.ts",
        "electron/ipc/transcribe.ts",
        "electron/ipc/subtitle.ts",
        "electron/preload/audio.ts",
        "electron/preload/subtitle.ts",
        "src/store/slices/historySlice.ts"
      ]
    },
    {
      "id": "image-translate",
      "signals": ["image", "vision", "ocr", "download translated image", "drag drop"],
      "likely_files": [
        "src/components/translate/ImageTranslator.tsx",
        "src/components/translate/ImageAttachmentPreview.tsx",
        "src/utils/imageUtils.ts",
        "electron/ipc/imageTranslate.ts",
        "electron/preload/chat.ts"
      ]
    },
    {
      "id": "chat",
      "signals": ["chat", "conversation", "system prompt", "preset", "deep research", "attachment"],
      "likely_files": [
        "src/pages/ChatPage.tsx",
        "src/components/chat/",
        "src/store/slices/chatSlice.ts",
        "src/services/chatService.ts",
        "electron/ipc/chat.ts",
        "electron/preload/chat.ts"
      ]
    },
    {
      "id": "tts-stt",
      "signals": ["voice", "speech", "tts", "stt", "whisper", "speaker", "listen"],
      "likely_files": [
        "src/hooks/useTTS.ts",
        "src/hooks/useVoiceInput.ts",
        "src/pages/settings/TtsSection.tsx",
        "src/pages/settings/SttSection.tsx",
        "electron/ipc/tts.ts",
        "electron/ipc/transcribe.ts",
        "electron/preload/audio.ts"
      ]
    },
    {
      "id": "settings-history-i18n",
      "signals": ["settings", "preference", "history", "locale", "language", "api key"],
      "likely_files": [
        "src/pages/SettingsPage.tsx",
        "src/pages/HistoryPage.tsx",
        "src/store/slices/settingsSlice.ts",
        "src/store/slices/historySlice.ts",
        "src/i18n/locales/",
        "src/i18n/types.ts"
      ]
    },
    {
      "id": "browser-extension",
      "signals": ["chrome extension", "bookmarklet", "browser", "local server", "popup", "options", "selection tooltip", "floating translate"],
      "likely_files": [
        "chrome-extension/popup.html",
        "chrome-extension/popup.js",
        "chrome-extension/options.html",
        "chrome-extension/options.js",
        "chrome-extension/content.js",
        "chrome-extension/content.css",
        "chrome-extension/extension-ui.css",
        "chrome-extension/background.js",
        "electron/ipc/localServer.ts",
        "electron/preload/localServer.ts",
        "electron/preload/legacyAssistant.ts"
      ],
      "ux_checks": [
        "Popup, Options và selection tooltip dùng cùng visual language",
        "Không dùng emoji làm action/status icon",
        "Không dùng inline SVG trang trí trong popup.js/content.js provider/action badges",
        "Missing token/offline/loading/error/success states rõ và recoverable",
        "Options lưu cùng target language và translation style mà popup/tooltip dùng"
      ]
    }
  ],
  "analysis_steps": [
    {
      "id": "step-1-product-fit",
      "name": "Product fit",
      "action": "Tóm tắt user need, success criteria, out-of-scope và liên hệ với PRD local-first translation assistant."
    },
    {
      "id": "step-2-domain-classification",
      "name": "Domain classification",
      "action": "Map request vào một hoặc nhiều feature_domains để xác định file/module cần đọc."
    },
    {
      "id": "step-3-impact-map",
      "name": "Impact map",
      "action": "Lập bảng Main/Preload/Renderer/Store/i18n/Test/Docs với thay đổi dự kiến."
    },
    {
      "id": "step-4-contracts",
      "name": "Contracts",
      "action": "Định nghĩa IPC channel, window.api shape, TypeScript types, store fields và i18n keys nếu cần."
    },
    {
      "id": "step-5-implementation-plan",
      "name": "Implementation plan",
      "action": "Sắp xếp thứ tự implement theo dependency: types/constants -> main IPC -> preload -> store/service -> UI -> tests -> docs."
    },
    {
      "id": "step-6-verification",
      "name": "Verification plan",
      "action": "Chọn test/build/lint/manual check tối thiểu đủ tin cậy theo blast radius."
    },
    {
      "id": "step-7-risks",
      "name": "Risks",
      "action": "Nêu privacy/security/provider/UX/migration risks và cách giảm rủi ro."
    },
    {
      "id": "step-8-extension-ux",
      "name": "Browser extension UX pass",
      "condition": "Request thuộc domain browser-extension",
      "action": "Kiểm tra popup/options/content tooltip theo R-VZN-EXT-UI-01, gồm visual parity, state UX, storage defaults và manual smoke translate/copy/replace/listen."
    }
  ],
  "output_format": {
    "sections": [
      "Product Fit",
      "Impact Map",
      "Contracts",
      "Implementation Plan",
      "Verification",
      "Risks"
    ]
  },
  "references": {
    "rule": "../../rule/viezan-product-engineering/rules.json",
    "workflow": "../../workflow/ship-viezan-feature/ship-viezan-feature.json",
    "readme": "./README.md"
  }
}
