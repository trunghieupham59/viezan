{
  "name": "score-code",
  "version": "1.0.0",
  "description": "Workflow chấm điểm source code theo bộ tiêu chí chuẩn",
  "type": "workflow",
  "steps": [
    {
      "id": "step-1-identify",
      "name": "Xác định loại bài",
      "description": "Xác định loại bài để chọn bộ rubric phù hợp",
      "action": "Hỏi hoặc suy luận loại bài từ code: cơ bản, OOP/backend, project lớn, hoặc viezan-electron",
      "options": [
        {
          "type": "basic",
          "label": "Bài lập trình cơ bản",
          "criteria": ["Correctness", "Code Quality", "Structure", "Testing", "Documentation"]
        },
        {
          "type": "oop-backend",
          "label": "Assignment OOP / Backend",
          "criteria": ["Correctness", "Code Quality", "Structure", "Maintainability", "Testing", "Architecture", "Documentation"]
        },
        {
          "type": "project",
          "label": "Project lớn / Đồ án nhóm",
          "criteria": ["Correctness", "Architecture", "Code Quality", "Maintainability", "Testing", "Performance", "Security", "Documentation"]
        },
        {
          "type": "viezan-electron",
          "label": "Viezan Electron local-first app",
          "criteria": ["Correctness", "Architecture", "Security", "Reliability", "Code Quality", "Maintainability", "Testing", "Performance", "Documentation"]
        }
      ]
    },
    {
      "id": "step-2-read",
      "name": "Đọc toàn bộ source code",
      "description": "Đọc qua toàn bộ file trước khi chấm",
      "action": "Đọc tất cả file, ghi nhận điểm nổi bật tốt và chưa tốt. Không chấm vội từng phần riêng lẻ"
    },
    {
      "id": "step-3-score",
      "name": "Chấm từng tiêu chí",
      "description": "Áp dụng skill score-code để chấm từng tiêu chí trong rubric đã chọn",
      "skill": "score-code",
      "action": "Với mỗi tiêu chí: đọc định nghĩa → tìm bằng chứng → ghi ví dụ cụ thể → cho điểm → kiểm tra không chấm trùng"
    },
    {
      "id": "step-4-summarize",
      "name": "Tổng hợp kết quả",
      "description": "Tổng hợp thành bảng điểm và báo cáo nhận xét",
      "output_format": {
        "table": ["Tiêu chí", "Điểm tối đa", "Điểm đạt", "Nhận xét"],
        "sections": ["Điểm mạnh", "Điểm cần cải thiện", "Khuyến nghị"]
      }
    },
    {
      "id": "step-5-verify",
      "name": "Kiểm tra lại",
      "description": "Kiểm tra không có tiêu chí chấm trùng, điểm phản ánh đúng thực tế",
      "checks": [
        "Không có 2 tiêu chí chấm trùng nhau",
        "Mỗi điểm trừ có ví dụ cụ thể từ code",
        "Tổng điểm không vượt quá 100"
      ]
    }
  ],
